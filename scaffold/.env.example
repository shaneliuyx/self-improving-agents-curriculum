# Generation backend: omlx | vibeproxy
AGENT_BACKEND=omlx

# Model served by oMLX (check http://localhost:8000/admin/chat for loaded models)
OMLX_MODEL=qwen2.5-coder-7b

# Model name for VibeProxy (routes your Claude MAX subscription)
# Note: using a subscription via proxy may violate provider ToS.
VIBE_MODEL=claude-sonnet-4-5

# Embeddings always use oMLX - VibeProxy has no embeddings endpoint
EMBED_BASE_URL=http://localhost:8000/v1
EMBED_MODEL=nomic-embed-text

# Local servers ignore this key; VibeProxy uses OAuth under the hood
LLM_API_KEY=not-needed

# Optional: max ReAct rounds per task before giving up
AGENT_MAX_ROUNDS=10

# Optional: minimum eval score improvement to accept a mutation (0.0 = any improvement)
EVOLVE_MIN_DELTA=0.05
