# Generation backend: omlx | vibeproxy
AGENT_BACKEND=omlx

# Model served by oMLX (check http://localhost:8000/admin/chat for loaded models)
OMLX_MODEL=qwen2.5-coder-7b

# Model routing (backends/router.py): set DISTINCT small/large models or routing
# is a no-op (both fall back to OMLX_MODEL). Small = cheap/intent steps, large =
# reasoning steps. Leave unset to disable size-based routing.
OMLX_SMALL_MODEL=qwen2.5-coder-3b-instruct-4bit
OMLX_LARGE_MODEL=qwen2.5-coder-7b

# Model name for VibeProxy (routes your Claude MAX subscription)
# IDs are dated - run: curl localhost:8317/v1/models   (Note: subscription-via-proxy may violate ToS.)
VIBE_MODEL=claude-sonnet-4-5-20250929

# Embeddings always use oMLX - VibeProxy has no embeddings endpoint
# Set EMBED_MODEL to the id oMLX serves (run: curl localhost:8000/v1/models)
EMBED_BASE_URL=http://localhost:8000/v1
EMBED_MODEL=Qwen3-Embedding-0.6B-4bit-DWQ

# oMLX API key (oMLX Preferences -> API). Required if oMLX auth is ON.
# Used for oMLX chat AND embeddings. Leave as not-needed if oMLX auth is OFF.
OMLX_API_KEY=not-needed
# VibeProxy uses OAuth and ignores this; any non-empty value is fine.
LLM_API_KEY=not-needed

# Optional: max ReAct rounds per task before giving up
AGENT_MAX_ROUNDS=10

# Optional: minimum eval score improvement to accept a mutation (0.0 = any improvement)
EVOLVE_MIN_DELTA=0.05
