#!/usr/bin/env bash
# scripts/commit - Safe git commit wrapper.
#
# Every self-modification accepted by the verification gate should be
# committed with this script so the improvement history is fully revertible.
#
# Usage:
#   ./scripts/commit "reason for change"
#
# What it does:
#   1. Verifies we are inside a git repository
#   2. Stages all tracked modified files (never uses --force or -f)
#   3. Shows a diff stat so you can see exactly what changed
#   4. Commits with the provided message
#   5. Never force-pushes (prints a reminder to push manually)
#
# What it does NOT do:
#   - Does not push automatically (push manually after review)
#   - Does not skip pre-commit hooks (--no-verify is never used)
#   - Does not force-push under any circumstances
#   - Does not commit .env or secrets (they should be in .gitignore)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

cd "$PROJECT_ROOT"

# Require a commit message
if [ $# -lt 1 ] || [ -z "$1" ]; then
    echo "Error: commit message required."
    echo "Usage: ./scripts/commit \"reason for change\""
    exit 1
fi

COMMIT_MSG="$1"

# Verify we are in a git repo
if ! git rev-parse --git-dir > /dev/null 2>&1; then
    echo "Error: not inside a git repository."
    echo "Run: git init && git add . && git commit -m 'initial commit'"
    exit 1
fi

# Show what will be staged
echo "--- Git status ---"
git status --short

echo ""
echo "--- Staging modified tracked files ---"
# Stage all modified/deleted tracked files (not untracked), never --force
git add -u

# Also stage new files in skills/SKILLS, evolve/archive (the dirs the agent writes to)
git add skills/SKILLS/ evolve/archive/ CHANGELOG.md 2>/dev/null || true

echo ""
echo "--- Diff stat ---"
git diff --cached --stat

# Abort if nothing staged
if git diff --cached --quiet; then
    echo "Nothing to commit (working tree clean)."
    exit 0
fi

echo ""
echo "--- Committing ---"
git commit -m "$COMMIT_MSG"

echo ""
echo "Committed. To push: git push"
echo "To revert this commit: git revert HEAD"
