#!/usr/bin/env bash
# scripts/go - One improvement iteration of the self-improving agent.
#
# What this script does (L2 deterministic layer - overrides L1 prose):
#   1. Print GOAL.md and AGENTS.md as context
#   2. Run a sample eval task through the agent loop
#   3. Reflect on the trajectory
#   4. Propose a skill from the trajectory
#   5. Run verification gates
#   6. If accepted: save skill, append to CHANGELOG, commit
#   7. Run the full eval suite and report score
#
# Usage:
#   ./scripts/go
#   AGENT_BACKEND=vibeproxy ./scripts/go
#
# Every accepted change is committed via scripts/commit so it is revertible.
# If an iteration regresses the eval score, run: git revert HEAD

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

cd "$PROJECT_ROOT"

# Activate venv if present
if [ -f ".venv/bin/activate" ]; then
    # shellcheck disable=SC1091
    source .venv/bin/activate
fi

# Load .env if present
if [ -f ".env" ]; then
    set -o allexport
    # shellcheck disable=SC1091
    source .env
    set +o allexport
fi

echo "============================================================"
echo "  Self-Improving Agent Lab - Improvement Iteration"
echo "  Backend: ${AGENT_BACKEND:-omlx}"
echo "============================================================"
echo ""

echo "--- GOAL ---"
cat GOAL.md
echo ""

echo "--- AGENTS CONTRACT (summary) ---"
head -30 AGENTS.md
echo "... (see AGENTS.md for full contract)"
echo ""

echo "--- Running improvement iteration ---"
python3 - <<'PYEOF'
import sys
import json
import datetime
from pathlib import Path

# Add project root to path
project_root = Path(__file__).parent.parent if "__file__" in dir() else Path(".")
sys.path.insert(0, str(project_root))

from config import settings
settings.validate()

from agent.loop import run_agent
from memory.store import MemoryStore
from reflection.reflect import reflect_on_trajectory
from skills.library import propose_skill, save_skill
from verification.gates import verify, VerdictStatus
from evals.tasks import TASKS
from evals.run import run_evals

store = MemoryStore()

# Step 1: Pick a sample task from the eval set
sample_task = TASKS[0]
print(f"[1/6] Running sample task: {sample_task.id!r}")
print(f"      Input: {sample_task.input}")

result = run_agent(task=sample_task.input)
print(f"      Answer: {result.answer[:120]}")
print(f"      Success: {result.success}  Rounds: {result.rounds_used}  Stop: {result.stop_reason}")

# Step 2: Record trajectory to episodic memory
print("\n[2/6] Recording trajectory to memory...")
traj_summary = json.dumps({
    "task": result.task,
    "success": result.success,
    "rounds": result.rounds_used,
    "answer": result.answer[:200],
}, indent=2)
mem_id = store.add(
    memory_type="episodic",
    content=f"Task: {result.task}\nAnswer: {result.answer[:200]}",
    metadata={"task_id": sample_task.id, "success": result.success},
)
print(f"      Stored as memory #{mem_id}")

# Step 3: Reflect on the trajectory
print("\n[3/6] Reflecting on trajectory...")
try:
    lessons = reflect_on_trajectory(result, store=store, save_to_memory=True)
    print(f"      Heuristic: {lessons.heuristic[:120]}")
    print(f"      Confidence: {lessons.confidence:.2f}")
except Exception as e:
    print(f"      Reflection failed (backend may be offline): {e}")
    print("      Continuing without reflection...")

# Step 4: Propose a skill
print("\n[4/6] Proposing skill from trajectory...")
trajectory_text = "\n".join(
    f"Round {s.round_num} [{s.role}]: {s.content[:100]}"
    for s in result.trajectory
)
try:
    skill = propose_skill(trajectory_text, source_task=result.task)
    if skill:
        print(f"      Proposed skill: {skill.name!r}")
        print(f"      Trigger: {skill.trigger[:80]}")
    else:
        print("      No reusable skill identified in this trajectory.")
except Exception as e:
    print(f"      Skill proposal failed (backend may be offline): {e}")
    skill = None

# Step 5: Verify the skill (or skip if none proposed)
print("\n[5/6] Running verification gates...")
if skill:
    # Run a quick eval to get scores
    # For speed, score the baseline without a custom prompt
    baseline_score = sum(1 for t in TASKS[:3] if t.checker(result.answer)) / 3
    # A newly proposed skill gets credit for the task it solved
    candidate_score = baseline_score + (0.1 if result.success else 0.0)

    verdict = verify(
        proposal={"type": "skill", "name": skill.name, "content": skill.description},
        candidate_score=min(candidate_score, 1.0),
        baseline_score=baseline_score,
        run_safety_check=False,  # skip LLM safety for speed in demo; enable in production
    )
    print(f"      Verdict: {verdict.status.value.upper()}  -  {verdict.reason}")

    if verdict.accepted:
        skill.eval_score = verdict.score
        saved_path = save_skill(skill)
        print(f"      Saved to: {saved_path.relative_to(project_root)}")
    else:
        print("      Skill discarded (gate rejected).")
        skill = None
else:
    verdict = None
    print("      No skill to verify.")

# Step 6: Run full eval suite
print("\n[6/6] Running full eval suite...")
try:
    report = run_evals(verbose=False)
    print(f"      Score: {report.score:.1%}  ({report.passed}/{report.total} passed)")
    for r in report.results:
        status = "PASS" if r.passed else "FAIL"
        print(f"        [{status}] {r.task_id}")
except Exception as e:
    print(f"      Eval suite failed (backend may be offline): {e}")
    report = None

# Append to CHANGELOG
print("\n--- Appending to CHANGELOG.md ---")
now = datetime.datetime.now().strftime("%Y-%m-%d %H:%M")
changelog_path = project_root / "CHANGELOG.md"
entry_lines = [
    f"\n## [{now}] Iteration",
    f"",
    f"- Task: {sample_task.id}  Success: {result.success}",
]
if skill and verdict and verdict.accepted:
    entry_lines.append(f"- Skill accepted: `{skill.name}`")
elif skill:
    entry_lines.append(f"- Skill proposed but rejected by verification gate.")
else:
    entry_lines.append(f"- No skill proposed.")
if report:
    entry_lines.append(f"- Eval score: {report.score:.1%} ({report.passed}/{report.total})")
entry_lines.append("")

with open(changelog_path, "a") as f:
    f.write("\n".join(entry_lines))
print("Done.")

print("\n============================================================")
print("  Iteration complete.")
if report:
    print(f"  Final eval score: {report.score:.1%}")
print("  To commit: ./scripts/commit 'iteration: <reason>'")
print("  To revert: git revert HEAD")
print("============================================================")
PYEOF
